DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/qlet_crm?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/qlet_crm?sslmode=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL="https://YOUR_UPSTASH_URL.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_TOKEN"

# Cloudflare Turnstile (bot protection on public form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="YOUR_TURNSTILE_SITE_KEY"
TURNSTILE_SECRET_KEY="YOUR_TURNSTILE_SECRET_KEY"

# Agent seed (used only during prisma db seed)
AGENT_SEED_EMAIL="agent@yourdomain.mt"
AGENT_SEED_PASSWORD="YourStrongPasswordHere"

# App URL (set to your Vercel deployment URL in production)
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Optional: Resend email (for future lead notification emails)
# RESEND_API_KEY="re_..."
